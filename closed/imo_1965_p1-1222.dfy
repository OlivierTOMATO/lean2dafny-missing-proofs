// split: the nlinarith step as its own small lemma over the abstract atoms a=√(1+s), b=√(1-s), s, c (all proofs checked)
lemma {:induction false} SqInj(p: real, q: real)
  requires 0.0 <= p && 0.0 <= q && p * p == q * q
  ensures p == q
{
  assert (p - q) * (p + q) == p * p - q * q;
  if p + q == 0.0 { assert p == 0.0 && q == 0.0; }
  else { ZeroOfMulRight(p - q, p + q); }
}
// Mathlib mul_eq_zero (one direction), proved here
lemma {:induction false} ZeroOfMulRight(u: real, v: real)
  requires u * v == 0.0 && v != 0.0
  ensures u == 0.0
{
  if u != 0.0 { assert u * v / v == u; }
}
lemma {:induction false} SplitCore(a: real, b: real, s: real, c: real)
  requires 0.0 <= a && 0.0 <= b && c <= 0.0
  requires a * a == 1.0 + s && b * b == 1.0 - s && c * c + s * s == 1.0
  ensures (b - a) * (b - a) == 2.0 + 2.0 * c
{
  assert (a * b) * (a * b) == (a * a) * (b * b);
  assert (a * a) * (b * b) == 1.0 - s * s;
  assert 0.0 <= a * b;
  SqInj(a * b, -c);
  assert (b - a) * (b - a) == a * a + b * b - 2.0 * (a * b);
}
